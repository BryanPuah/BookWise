---
const year = new Date().getFullYear();
---
<footer class="px-6 py-12 border-t border-line">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-serif text-sm text-ink-muted">Bookwise · A reading companion</p>
    <div class="flex items-center gap-6 font-sans text-xs text-ink-faint">
      <span>© {year}</span>
      <a href="#" class="hover:text-ink transition-colors">Privacy</a>
      <a href="mailto:hello@bookwise.app" class="hover:text-ink transition-colors">Contact</a>
    </div>
  </div>
</footer>
